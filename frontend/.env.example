# Platewise Frontend Environment Variables (for Vercel & local dev)

# Backend Render API URL (e.g. https://platewise-backend.onrender.com)
# In local development, leave empty to use Vite proxy (/api -> localhost:3001)
VITE_API_BASE_URL=""
BACKEND_API_URL=""

# Supabase Client Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
