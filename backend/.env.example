# Platewise Backend Environment Variables
PORT=3001
NODE_ENV=production

# Google Gemini API Key for Food Vision Analysis
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Allowed Frontend URL for CORS (comma-separated if multiple, e.g. https://platewise.vercel.app)
FRONTEND_URL="http://localhost:3000,http://localhost:5173"

# Supabase (Optional for Database/Auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
